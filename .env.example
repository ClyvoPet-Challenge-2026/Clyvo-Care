# --- [PRODUÇÃO / AZURE] (Padrão para testes e avaliação) ---
# Origens das APIs publicadas na Azure (manter sem '/api' no final da URL .NET)
EXPO_PUBLIC_API_URL=https://clyvocare-java-rm561584.azurewebsites.net
EXPO_PUBLIC_DOTNET_API_URL=https://clyvocare-dotnet-rm561584.azurewebsites.net

# API do Chatbot com Inteligência Artificial (FastAPI / Gemini)
# Produção / Azure ACI ou Cloudflare: https://sua-api-chatbot.azurecontainer.io ou http://localhost:8000
EXPO_PUBLIC_CHATBOT_API_URL=http://localhost:8000

# Configuração da URL da API Java Spring Boot para o Expo
# Celular físico (Expo Go): use o IPv4 da sua máquina na mesma rede Wi-Fi
